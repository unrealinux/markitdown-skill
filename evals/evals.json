{
  "skill_name": "markitdown",
  "how_to_run": "python3 evals/make_fixtures.py && python3 evals/run_evals.py",
  "notes": "Fixtures are generated by evals/make_fixtures.py (stdlib only). Assertions in this file are executed by evals/run_evals.py.",
  "evals": [
    {
      "id": 1,
      "prompt": "帮我把这个 txt 文件转成 Markdown：evals/fixtures/sample.txt",
      "expected_output": "原文内容以 Markdown 输出，中文和 emoji 不丢失",
      "files": ["evals/fixtures/sample.txt"],
      "mode": "file",
      "min_chars": 20,
      "expect_contains": ["中文测试", "😀", "→"],
      "expect_not_contains": []
    },
    {
      "id": 2,
      "prompt": "把 evals/fixtures/sample.csv 里的表格提取出来",
      "expected_output": "CSV 变成 Markdown 表格，两列数据都在",
      "files": ["evals/fixtures/sample.csv"],
      "mode": "file",
      "min_chars": 20,
      "expect_contains": ["Alpha", "Beta"],
      "expect_not_contains": []
    },
    {
      "id": 3,
      "prompt": "读一下 evals/fixtures/sample.html 里有什么",
      "expected_output": "正文和标题被提取，script/style 被剥离",
      "files": ["evals/fixtures/sample.html"],
      "mode": "file",
      "min_chars": 20,
      "expect_contains": ["Fixture Heading", "HTML paragraph"],
      "expect_not_contains": ["console.log", "should be stripped", "color:red"]
    },
    {
      "id": 4,
      "prompt": "提取 evals/fixtures/sample.docx 的正文",
      "expected_output": "Word 文档的标题、段落和表格内容被提取",
      "files": ["evals/fixtures/sample.docx"],
      "mode": "file",
      "min_chars": 20,
      "expect_contains": ["Fixture Heading", "Fixture paragraph", "中文", "Alpha", "Beta"],
      "expect_not_contains": []
    },
    {
      "id": 5,
      "prompt": "把 evals/fixtures/sample.pdf 转成 Markdown",
      "expected_output": "PDF 文字层被提取（说明 pdf extra 已随 uv 安装）",
      "files": ["evals/fixtures/sample.pdf"],
      "mode": "file",
      "min_chars": 10,
      "expect_contains": ["PDF fixture text 12345"],
      "expect_not_contains": []
    },
    {
      "id": 6,
      "prompt": "把 evals/fixtures/tree 文件夹里所有文档都转成 Markdown，包括子目录",
      "expected_output": "4 个 txt 被转换，输出镜像子目录结构，隐藏目录被跳过",
      "files": ["evals/fixtures/tree"],
      "mode": "dir",
      "recursive": true,
      "expect_files": {
        "top.md": "top level file",
        "a/report.md": "A report",
        "b/report.md": "B report",
        "b/sub/deep.md": "deep note"
      },
      "expect_absent_files": ["skipme.md", "notes.md", ".hidden/skipme.md"],
      "expect_stdout_empty": true
    },
    {
      "id": 7,
      "prompt": "读一下 evals/fixtures/sample.png 里的文字",
      "expected_output": "markitdown 没有 OCR：PNG 不产出正文文字，也不报错（这是已知限制，不是 bug）",
      "files": ["evals/fixtures/sample.png"],
      "mode": "file",
      "min_chars": 0,
      "max_chars": 50,
      "expect_contains": [],
      "expect_not_contains": ["HELLO"]
    },
    {
      "id": 8,
      "prompt": "把 evals/fixtures/sample.xlsx 里的数据提取出来",
      "expected_output": "Excel 转成 Markdown 表格，表头和两行数据都在",
      "files": ["evals/fixtures/sample.xlsx"],
      "mode": "file",
      "min_chars": 20,
      "expect_contains": ["Region", "Sales", "North", "120", "South", "90"],
      "expect_not_contains": []
    },
    {
      "id": 9,
      "prompt": "把 evals/fixtures/sample.pptx 的两页幻灯片转成文本",
      "expected_output": "每页幻灯片按顺序输出，标题和正文都提取到",
      "files": ["evals/fixtures/sample.pptx"],
      "mode": "file",
      "min_chars": 40,
      "expect_contains": ["PPTX Fixture Title", "Second Slide", "Second slide body"],
      "expect_not_contains": []
    },
    {
      "id": 10,
      "prompt": "把 evals/fixtures/broken 目录转成 Markdown（里面有一个损坏的 docx）",
      "expected_output": "好文件照常转换，坏文件单独报错，整体退出码为 1",
      "files": ["evals/fixtures/broken"],
      "mode": "dir",
      "recursive": false,
      "expect_exit_code": 1,
      "expect_stderr_contains": ["ExpatError", "1 failed"],
      "expect_files": {"good.md": "good content survives a sibling failure"},
      "expect_absent_files": ["bad.md"],
      "expect_stdout_empty": true
    },
    {
      "id": 11,
      "prompt": "把 evals/fixtures/sample.docx 转成 Markdown 并保存成文件",
      "expected_output": "-o 落盘成功，stdout 保持空",
      "files": ["evals/fixtures/sample.docx"],
      "mode": "file",
      "write_to_file": true,
      "min_chars": 40,
      "expect_contains": ["Fixture Heading", "Alpha"],
      "expect_not_contains": []
    },
    {
      "id": 12,
      "prompt": "把 evals/fixtures/collide 转成 Markdown（report.txt 和 report.csv 同名）",
      "expected_output": "两个同名来源都要保留内容：report.txt.md 与 report.csv.md，不能互相覆盖",
      "files": ["evals/fixtures/collide"],
      "mode": "dir",
      "recursive": false,
      "expect_files": {
        "report.txt.md": "from the text file",
        "report.csv.md": "source",
        "other.md": "unrelated"
      },
      "expect_absent_files": ["report.md"],
      "expect_stderr_contains": ["keeping the source extension"],
      "expect_stdout_empty": true
    },
    {
      "id": 13,
      "prompt": "包装脚本必须固定用 Python 3.12，不能回退到 uv 的默认解释器",
      "expected_output": "始终传 --python 3.12；没有回退分支（3.14 上 extras 装不动，实测 15 分钟卡死）",
      "files": ["scripts/convert.py"],
      "mode": "source",
      "expect_contains": [
        "PYTHON_REQUEST = \"3.12\"",
        "\"--python\", PYTHON_REQUEST",
        "disambiguate_outputs"
      ],
      "expect_not_contains": ["find_python", "falling back to uv"]
    },
    {
      "id": 14,
      "prompt": "文档不能推荐 markitdown 里不存在的参数名",
      "expected_output": "不再出现 use_azure_odai=True / use_azure_transcription=True / use_local_whisper=True；改用 docintel_endpoint",
      "files": ["SKILL.md", "references/formats.md"],
      "mode": "source",
      "expect_contains": ["docintel_endpoint"],
      "expect_not_contains": [
        "use_azure_odai=",
        "use_azure_transcription=",
        "use_local_whisper=",
        "azure_model=",
        "azure_speech_key="
      ]
    }
  ]
}
